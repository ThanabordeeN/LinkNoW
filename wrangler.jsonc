{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linknow",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "me.nounxlab.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
